<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="form" uri="http://www.springframework.org/tags/form" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Review artifact | Artifact Alley</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="/css/site.css" rel="stylesheet"></head><body><nav class="navbar navbar-dark auction-nav"><div class="container"><a class="navbar-brand" href="/">Artifact Alley</a><a class="btn btn-outline-light btn-sm" href="/admin/artifacts/pending">Review queue</a></div></nav>
<main class="container py-5"><c:if test="${not empty errorMessage}"><div class="alert alert-danger"><c:out value="${errorMessage}"/></div></c:if><p class="eyebrow text-dark">ADMIN REVIEW</p><h1><c:out value="${artifact.title}"/></h1>
<div class="image-gallery my-4"><c:choose><c:when test="${empty artifactImages}"><div class="artifact-placeholder">No photos supplied</div></c:when><c:otherwise><c:forEach items="${artifactImages}" var="image"><figure><img src="${imageUrls[image.id]}" alt="${fn:escapeXml(artifact.title)}"><figcaption><c:out value="${image.originalFilename}"/><c:if test="${image.coverImage}"> · Cover</c:if></figcaption></figure></c:forEach></c:otherwise></c:choose></div>
<article class="artifact-card p-4 mb-4"><p><strong>Seller:</strong> <c:choose><c:when test="${not empty artifact.seller}"><c:out value="${artifact.seller.name}"/> — <c:out value="${artifact.seller.email}"/></c:when><c:otherwise>Ownership unresolved</c:otherwise></c:choose></p><p><strong>Category:</strong> <c:out value="${artifact.category}"/> · <strong>Era:</strong> <c:out value="${artifact.era}"/></p><p><strong>Starting price:</strong> ₹ <c:out value="${artifact.startingPrice}"/> · <strong>Closes:</strong> <c:out value="${artifact.closesAt}"/></p><p class="description"><c:out value="${artifact.description}"/></p><p class="small text-muted">Submitted <c:out value="${artifact.submittedAt}"/> · updated <c:out value="${artifact.updatedAt}"/></p></article>
<div class="row g-3"><div class="col-md-4"><form action="/admin/artifacts/${artifact.id}/approve" method="post"><button class="btn btn-primary w-100" type="submit">Approve and publish</button></form></div><div class="col-md-8"><form:form action="/admin/artifacts/${artifact.id}/reject" method="post" modelAttribute="artifactReviewForm"><form:label path="reason" cssClass="form-label">Reason for rejection</form:label><form:textarea path="reason" cssClass="form-control" rows="3" maxlength="500"/><form:errors path="reason" cssClass="invalid-feedback d-block"/><button class="btn btn-outline-danger mt-2" type="submit">Reject with feedback</button></form:form></div></div></main></body></html>
